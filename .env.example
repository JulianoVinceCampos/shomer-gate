# shomer-gate example environment. Copy to .env and change the signing key.
# The signing key protects BOTH the JWT session tokens and the ledger HMAC.
# In production this comes from a vault, never from a file in the repo.
SHOMER_SIGNING_KEY=change-me-to-a-long-random-string-min-32-bytes

# Demo credentials. The password is stored only as a salted hash at boot;
# the plaintext below is read once and never persisted.
SHOMER_ADMIN_USER=shomer
SHOMER_ADMIN_PASSWORD=emet-2026

# Session lifetime in seconds (default 1h).
SHOMER_TOKEN_TTL=3600

# Guardrail thresholds (see docs/metrics.md for calibration).
SHOMER_BLOCK_THRESHOLD=7.0
SHOMER_REVIEW_THRESHOLD=3.0

# API bind.
SHOMER_HOST=0.0.0.0
SHOMER_PORT=8080
